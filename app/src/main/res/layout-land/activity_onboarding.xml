<?xml version="1.0" encoding="utf-8"?>
<!-- Sideways there is no height to share, so the table sits beside the words instead of above them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gutter">

        <app.flipsilence.OnboardingStage
            android:id="@+id/stage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/gutter"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <include layout="@layout/onboarding_head" />

                <include layout="@layout/onboarding_words" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
