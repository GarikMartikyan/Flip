<?xml version="1.0" encoding="utf-8"?>
<!--
  First launch: the table with the phone on it takes whatever height the words leave, so a tall
  screen gets a big phone and a short one (or a large font) scrolls with the phone at its smallest.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <app.flipsilence.ContentColumn
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <include layout="@layout/onboarding_head" />

        <app.flipsilence.OnboardingStage
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="240dp" />

        <include layout="@layout/onboarding_words" />
    </app.flipsilence.ContentColumn>
</ScrollView>
