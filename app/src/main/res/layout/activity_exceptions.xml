<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <app.flipsilence.ContentColumn
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <!-- The back button's glyph lines up with the gutter; its 48dp target overhangs into it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:text="@string/gets_through"
                android:textColor="@color/ink"
                android:textSize="30sp" />
        </LinearLayout>

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/gets_through_blurb" />

        <!-- People: the phone's starred contacts, which the Do Not Disturb rule lets ring as a whole. -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:accessibilityHeading="true"
            android:text="@string/people" />

        <LinearLayout
            style="@style/Card.Rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout style="@style/CardRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/favourites" />

                    <TextView
                        style="@style/RowCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/favourites_blurb" />
                </LinearLayout>

                <Switch
                    android:id="@+id/favourites_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/favourites"
                    android:minHeight="48dp"
                    android:showText="false"
                    android:switchMinWidth="0dp"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/people_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/CardRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/repeat_callers" />

                    <TextView
                        style="@style/RowCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/repeat_callers_blurb" />
                </LinearLayout>

                <Switch
                    android:id="@+id/repeat_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/repeat_callers"
                    android:minHeight="48dp"
                    android:showText="false"
                    android:switchMinWidth="0dp"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/add_person"
            style="@style/FlipButton.Outline"
            android:layout_marginTop="12dp"
            android:drawableStart="@drawable/ic_plus"
            android:drawablePadding="8dp"
            android:paddingStart="18dp"
            android:text="@string/add_person" />

        <TextView
            style="@style/RowCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/people_note" />

        <!-- Apps: Flip's own list, alerted for by Flip itself through notification access. -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:accessibilityHeading="true"
            android:text="@string/apps" />

        <LinearLayout
            style="@style/Card.Rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/apps_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/listener_row"
                style="@style/CardRow.Clickable">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notification_access" />

                    <TextView
                        android:id="@+id/listener_status"
                        style="@style/RowCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/add_app"
            style="@style/FlipButton.Outline"
            android:layout_marginTop="12dp"
            android:drawableStart="@drawable/ic_plus"
            android:drawablePadding="8dp"
            android:paddingStart="18dp"
            android:text="@string/add_app" />

        <TextView
            style="@style/RowCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/apps_note" />

    </app.flipsilence.ContentColumn>
</ScrollView>
