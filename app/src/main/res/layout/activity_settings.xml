<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <app.flipsilence.ContentColumn
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <!-- The back button's glyph lines up with the gutter; its 48dp target overhangs into it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:text="@string/settings"
                android:textColor="@color/ink"
                android:textSize="30sp" />
        </LinearLayout>

        <!-- Theme: the app's own override of the system's light or dark. -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/theme" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/segment_track"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/theme_system"
                style="@style/IconSegment"
                android:layout_width="0dp"
                android:layout_weight="1">

                <ImageView
                    style="@style/IconSegmentIcon"
                    android:src="@drawable/ic_phone" />

                <TextView
                    style="@style/IconSegmentText"
                    android:text="@string/theme_system" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/theme_light"
                style="@style/IconSegment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp">

                <ImageView
                    style="@style/IconSegmentIcon"
                    android:src="@drawable/ic_sun" />

                <TextView
                    style="@style/IconSegmentText"
                    android:text="@string/theme_light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/theme_dark"
                style="@style/IconSegment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp">

                <ImageView
                    style="@style/IconSegmentIcon"
                    android:src="@drawable/ic_moon" />

                <TextView
                    style="@style/IconSegmentText"
                    android:text="@string/theme_dark" />
            </LinearLayout>
        </LinearLayout>

        <!-- Language: the system's, or one Flip is written in, picked on its own page. -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:accessibilityHeading="true"
            android:text="@string/language" />

        <LinearLayout
            style="@style/Card.Rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/language_row"
                style="@style/CardRow.Clickable">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/language_name"
                        style="@style/RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/language_caption"
                        style="@style/RowCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sensitivity: the pocket-versus-desk call, handed to the user rather than guessed. -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:accessibilityHeading="true"
            android:text="@string/sensitivity" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/segment_track"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/sens_strict"
                style="@style/Segment"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/sens_balanced"
                style="@style/Segment"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/sens_relaxed"
                style="@style/Segment"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/sens_blurb"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp" />

        <!--
          Sleep: whether last night is worked out at all, and the one habit it needs, shown moving
          underneath rather than written out.
        -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:accessibilityHeading="true"
            android:text="@string/sleep_section" />

        <LinearLayout
            style="@style/Card.Rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout style="@style/CardRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sleep_monitoring" />

                    <TextView
                        style="@style/RowCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sleep_monitoring_blurb" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sleep_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/sleep_monitoring"
                    android:minHeight="48dp"
                    android:showText="false"
                    android:switchMinWidth="0dp"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <app.flipsilence.SleepExplainer
                android:id="@+id/sleep_explainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/sleep_explainer_caption"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minLines="2"
                android:paddingHorizontal="@dimen/card_padding"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:accessibilityHeading="true"
            android:text="@string/feedback" />

        <LinearLayout
            style="@style/Card.Rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout style="@style/CardRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/haptics" />

                    <TextView
                        style="@style/RowCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/haptics_blurb" />
                </LinearLayout>

                <Switch
                    android:id="@+id/haptics_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/haptics"
                    android:minHeight="48dp"
                    android:showText="false"
                    android:switchMinWidth="0dp"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout style="@style/CardRow">

                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/notification_show" />

                <Switch
                    android:id="@+id/notification_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/notification_show"
                    android:minHeight="48dp"
                    android:showText="false"
                    android:switchMinWidth="0dp"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:accessibilityHeading="true"
            android:text="@string/system" />

        <LinearLayout
            style="@style/Card.Rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/dnd_row"
                style="@style/CardRow.Clickable">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dnd_access" />

                    <TextView
                        android:id="@+id/dnd_status"
                        style="@style/RowCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View style="@style/RowDivider" />

            <LinearLayout
                android:id="@+id/battery_row"
                style="@style/CardRow.Clickable">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/battery" />

                    <TextView
                        android:id="@+id/battery_status"
                        style="@style/RowCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/diagnostics_toggle"
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:accessibilityHeading="true"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:drawableEnd="@drawable/chevron_toggle"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/diagnostics" />

        <LinearLayout
            android:id="@+id/diagnostics_body"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <!--
              Columns of aligned numbers: the only place a monospace face earns its keep. Scrolls
              sideways rather than wrapping, so the columns survive a narrow screen or a big font.
            -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/ink_dim"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </HorizontalScrollView>
        </LinearLayout>

    </app.flipsilence.ContentColumn>
</ScrollView>
