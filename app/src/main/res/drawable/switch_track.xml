<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawn here rather than tinted, so the switch looks the same on One UI as anywhere else. The side
  padding keeps the thumb 4dp in from each end.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <size android:width="40dp" android:height="24dp" />
            <padding android:left="4dp" android:right="4dp" />
            <solid android:color="@color/awake" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <size android:width="40dp" android:height="24dp" />
            <padding android:left="4dp" android:right="4dp" />
            <solid android:color="@color/track" />
            <stroke android:width="1dp" android:color="@color/ink_dim" />
        </shape>
    </item>
</selector>
