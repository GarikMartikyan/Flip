<?xml version="1.0" encoding="utf-8"?>
<!-- The fully rounded strip under the gauge that stands for everything still getting through. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
</ripple>
